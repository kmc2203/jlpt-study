  "傲": "{亻}(사람) + {敖}(음 ゴウ) — 거만해요.",
  "刹": "杀(죽이는) {刂}(칼) 같은 찰나, 절이에요.",
  "喩": "{口}(입) + {兪}(음 ユ) — 비유해 깨우쳐요.",
  "嘲": "{口}(입) + {朝}(음 チョウ) — 입으로 비웃어요.",
  "毀": "{臼}(절구)에 {土}(흙)을 {殳}(쳐서) 헐어요.",
  "彙": "{彑}(돼지머리)처럼 {果}(열매)를 모은 어휘예요.",
  "慄": "{忄}(마음) + {栗}(음 リツ) — 마음이 떨려요.",
  "憬": "{忄}(마음) + {景}(음 ケイ) — 동경해요.",
  "拉": "{扌}(손) + {立}(음 リツ·ラツ) — 끌어가요.",
  "曖": "{日}(해) + {愛}(음 アイ) — 희미해요.",
  "楷": "{木}(나무) + {皆}(음 カイ) — 본보기 해서체예요.",
  "鬱": "林(숲)에 {缶}(항아리)·{鬯}(술) 가득 답답하고 울창해요.",
  "璧": "{辟}(음 ヘキ) + {玉}(옥) — 둥근 옥, 구슬이에요.",
  "瘍": "{疒}(병) + {昜}(음 ヨウ) — 종기·종양이에요.",
  "箋": "{竹}(대쪽) + {戔}(음 セン) — 종이 쪽지예요.",
  "籠": "{竹}(대나무) + {龍}(음 リュウ·ロウ) — 엮은 바구니예요.",
  "羞": "{羊}(양)을 {丑}(손에 쥐고) 올리며 부끄러워해요.",
  "諧": "{言}(말) + {皆}(음 カイ) — 말이 어울려요.",
  "貪": "{今}(지금) {貝}(재물)을 탐내요.",
  "踪": "{足}(발) + {宗}(음 ソウ) — 발자취예요.",
  "辣": "{辛}(매운) {束}(묶음) 맵고 신랄해요.",
  "錮": "{金}(쇠)로 {固}(굳게) 가둬요.",
  "塡": "{土}(흙) + {眞}(음 シン·テン) — 흙으로 메워요.",
  "頰": "{夾}(음 キョウ) + {頁}(얼굴) — 뺨이에요."
 }
}
